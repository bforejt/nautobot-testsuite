     answers the per-VM fetch with a missingSet. -->
<soapenv:Envelope xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/" xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<soapenv:Body>
<RetrievePropertiesExResponse xmlns="urn:vim25"><returnval>
<objects>
<obj type="HostSystem">ha-host</obj>
<propSet><name>vm</name><val xsi:type="ArrayOfManagedObjectReference"><ManagedObjectReference type="VirtualMachine" xsi:type="ManagedObjectReference">1</ManagedObjectReference><ManagedObjectReference type="VirtualMachine" xsi:type="ManagedObjectReference">2</ManagedObjectReference><ManagedObjectReference type="VirtualMachine" xsi:type="ManagedObjectReference">42</ManagedObjectReference></val></propSet>
</objects>
</returnval></RetrievePropertiesExResponse>
</soapenv:Body>
</soapenv:Envelope>
