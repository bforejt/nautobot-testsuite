<?xml version="1.0" encoding="UTF-8"?>
<!-- Time, services, advanced options, autostart and firewall property groups
     in one RetrieveResult (the fake context filters them per request). Every
     OptionValue.value IS xsi-typed (the one place hostd types leaves inside a
     data object); summary.managementServerIp is unset on a standalone host and
     therefore absent from the propSet, not a missingSet entry. The option list
     is a small curated sample of the ~1 200 a real host returns, including one
     invented credential-looking key to exercise the raw-bundle scrub. -->
<soapenv:Envelope xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/" xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<soapenv:Body>
<RetrievePropertiesExResponse xmlns="urn:vim25"><returnval>
<objects>
<obj type="HostSystem">ha-host</obj>
<propSet><name>config.autoStart</name><val xsi:type="HostAutoStartManagerConfig">
<defaults><enabled>true</enabled><startDelay>120</startDelay><stopDelay>120</stopDelay><waitForHeartbeat>false</waitForHeartbeat><stopAction>guestShutdown</stopAction></defaults>
<powerInfo><key type="VirtualMachine">1</key><startOrder>1</startOrder><startDelay>-1</startDelay><waitForHeartbeat>systemDefault</waitForHeartbeat><startAction>powerOn</startAction><stopDelay>-1</stopDelay><stopAction>systemDefault</stopAction></powerInfo>
