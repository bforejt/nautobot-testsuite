<service><key>snmpd</key><label>SNMP Server</label><required>false</required><uninstallable>false</uninstallable><running>false</running><ruleset>snmp</ruleset><policy>on</policy><sourcePackage><sourcePackageName>esx-base</sourcePackageName><description>This VIB contains all of the base functionality of vSphere ESXi.</description></sourcePackage></service>
